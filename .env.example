POSTGRES_USER=transcendence
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transcendence

DATABASE_URL=postgres://transcendence:changeme@localhost:5432/transcendence

PORT=3000
RUST_LOG=info

# PeerTube instance queried by /media (the only host allowed server-side)
PEERTUBE_URL=https://framatube.org

# --- Google / GitHub login (OAuth) ---
# Public backend URL: used to build the OAuth return address. Goes through
# nginx (HTTPS, /api prefix) - the browser never talks to the backend
# directly, see docker/frontend/nginx.conf.template. Same address in
# `make dev` (native backend) and `make up` (everything in Docker): nginx
# routes to one or the other based on BACKEND_UPSTREAM (see Makefile), the
# browser never sees the difference.
BACKEND_URL=https://localhost:8080/api
# Allowed site origins, comma-separated. After a Google/GitHub login, the
# browser is redirected back to whichever one it came from.
FRONTEND_URL=https://localhost:8080

# APPLICATION keys (not your password): obtained by registering SyncWatch
# with the provider. Empty = button shown but disabled.
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://localhost:8080/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers  (OAuth Apps)
#   Authorization callback URL: https://localhost:8080/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
