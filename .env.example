POSTGRES_USER=transcendence
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transcendence

DATABASE_URL=postgres://transcendence:changeme@localhost:5432/transcendence

PORT=3000
RUST_LOG=info

# Instance PeerTube interrogee par /media (seul hote autorise cote serveur)
PEERTUBE_URL=https://framatube.org

# --- Connexion Google / GitHub (OAuth) ---
# URL publique du backend : sert a construire l'adresse de retour OAuth.
# Passe par nginx (HTTPS, prefixe /api) : le navigateur ne parle jamais au
# backend en direct, voir docker/frontend/nginx.conf.
BACKEND_URL=https://localhost:8443/api
# Adresses du site autorisees, separees par des virgules. Apres une connexion
# Google/GitHub, le navigateur est renvoye vers celle d'ou il venait.
FRONTEND_URL=https://localhost:8443

# Cles de l'APPLICATION (pas ton mot de passe) : obtenues en declarant
# SyncWatch chez le fournisseur. Vide = bouton affiche mais indisponible.
# Google : https://console.cloud.google.com/apis/credentials
#   URI de redirection autorisee : https://localhost:8443/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub : https://github.com/settings/developers  (OAuth Apps)
#   Authorization callback URL : https://localhost:8443/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
