    },
    {
      "id": 6,
      "type": "stat",
      "title": "Erreurs 5xx",
      "description": "Part des réponses en erreur serveur sur 5 minutes. Alerte HighErrorRate au-delà de 5 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(http_requests_total{job=\"backend\", status=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_requests_total{job=\"backend\"}[5m]))",
          "refId": "A",
          "legendFormat": "__auto"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "noValue": "—",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Latence p95",
      "description": "95 % des requêtes sont plus rapides que cette durée (5 dernières minutes). Alerte HighLatencyP95 au-delà de 1 s.",
