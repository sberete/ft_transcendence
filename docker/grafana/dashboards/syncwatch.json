    {
      "id": 10,
      "type": "table",
      "title": "Alertes en cours",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Alertes Prometheus en attente (pending) ou déclenchées (firing). Règles : docker/prometheus/alerts.yml.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ALERTS{alertstate=~\"pending|firing\"}",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "Value": true
            },
            "indexByName": {
              "alertname": 0,
              "alertstate": 1,
              "severity": 2,
              "job": 3,
              "instance": 4
            },
            "renameByName": {
              "alertname": "Alerte",
              "alertstate": "État",
              "severity": "Sévérité",
              "job": "Job",
              "instance": "Cible"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Aucune alerte en cours",
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "color-text"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "firing": {
                  "color": "red",
                  "index": 0
                },
                "pending": {
                  "color": "orange",
                  "index": 1
                },
                "critical": {
                  "color": "red",
                  "index": 2
                },
                "warning": {
                  "color": "orange",
                  "index": 3
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
