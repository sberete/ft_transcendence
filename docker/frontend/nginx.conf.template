# ${BACKEND_UPSTREAM} is substituted at container startup by the official
# nginx image (envsubst over /etc/nginx/templates/*.template files), only
# for names that actually exist as environment variables: nginx's own
# variables ($host, $uri, $http_upgrade...) aren't among them and stay
# untouched. This lets nginx point either at the backend container
# (make up) or at a native `cargo run` via host.docker.internal (make dev),
# without duplicating this file.
server {
    listen 443 ssl;
    http2 on;
    root /usr/share/nginx/html;
    index index.html;

    ssl_certificate /etc/nginx/certs/syncwatch.crt;
    ssl_certificate_key /etc/nginx/certs/syncwatch.key;

    # Internal Docker DNS, with a short TTL: by default, nginx resolves the
    # host once at startup and caches the IP. If the backend container
    # restarts (its IP changes), nginx stays stuck on the old address until
    # it restarts itself. Going through a variable forces a fresh
    # resolution on every request.
    resolver 127.0.0.11 valid=10s;
    set $backend_upstream ${BACKEND_UPSTREAM};

    # index.html must never be cached: it's the one referencing the
    # current JS bundle's (hashed) name. Without this, a browser could
    # serve a stale page pointing at a bundle that no longer exists/is
    # outdated.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Files under /assets have a hash in their name (e.g. index-Cym4yT65.js):
    # a new build generates a new name, so these can be cached for a long
    # time without ever risking serving stale content.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Uploaded avatars: served directly by the backend, not under /api
    # because these are raw <img src> requests, not fetch() calls. No Vue
    # Router route is named /uploads, so there's no possible collision.
    location /uploads/ {
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # REST API: /api prefix to avoid any collision with Vue Router pages
    # (e.g. /friends exists on both sides - page AND endpoint). Using
    # proxy_pass with a variable (dynamic DNS) disables nginx's automatic
    # URI rewriting, so we strip the /api prefix by hand.
    location /api/ {
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket (chat + playback sync): connection upgrade + extended
    # timeout (a room can stay open for a long time without traffic).
    location /api/ws {
        rewrite ^/api/ws(.*)$ /ws$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
    }

    # If the backend is unreachable (restarting, crashed, not started yet
    # in native dev mode), return a quick error rather than leaving the
    # browser waiting indefinitely.
    proxy_connect_timeout 5s;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
